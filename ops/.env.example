# OSCAR runtime overrides — copy to ops/.env to activate.
# Compose auto-loads ops/.env when invoked via `make up`, `make up-rtsp`, etc.
# Empty values fall back to whatever config/oscar.json holds.

# ---------- Camera ----------
# Examples:
#   USB by index (Linux host w/ devices passthrough):  OSCAR_CAMERA_SOURCE=0
#   Linux device path:                                 OSCAR_CAMERA_SOURCE=/dev/video1
#   RTSP from phone IP-cam app (see README §3.3):      OSCAR_CAMERA_SOURCE=rtsp://192.168.0.10:8080/h264_ulaw.sdp
#   HTTP MJPEG stream:                                 OSCAR_CAMERA_SOURCE=http://192.168.0.10:8080/video
#   File loop (for testing):                           OSCAR_CAMERA_SOURCE=/path/inside/container/clip.mp4
OSCAR_CAMERA_SOURCE=

# ---------- Inference ----------
# Set to "0"/"false" to attempt real model load instead of stub.
OSCAR_INFERENCE_STUB=
# Path inside the container (mount the file via compose volumes if external).
OSCAR_INFERENCE_MODEL=

# ---------- HTTP server ----------
OSCAR_HTTP_PORT=
OSCAR_HTTP_BIND=
